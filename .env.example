# Copy this file to .env and edit. Never commit .env.
#
# Windows: the password is the one you chose during PostgreSQL installation.
# The default superuser is "postgres".

# ---------- Database ----------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/schememedia

# Optional. Defaults to DATABASE_URL with a "_test" suffix, which is almost
# always what you want. Uncomment only to point tests elsewhere.
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/schememedia_test

# Set to true ONLY when using a pooled endpoint (Neon's pooler, or any
# PgBouncer in transaction mode). Leave false for a local installation.
DB_DISABLE_STATEMENT_CACHE=false

# ---------- Application ----------
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# Comma-separated. Never use "*" -- invalid alongside credentials.
CORS_ORIGINS=http://localhost:3000

# ---------- AI assistant (services/assistant.py) ----------
# gemini (default) has a genuine free tier -- get a key at
# https://aistudio.google.com/apikey. anthropic is optional and paid.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------- Optional Docker Compose only ----------
# Ignored during native local development.
POSTGRES_USER=schememedia
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=schememedia
POSTGRES_PORT=5432
API_PORT=8000
