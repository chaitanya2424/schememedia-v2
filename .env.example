# Copy this file to .env and edit. Never commit .env.
#
# Windows: the password is the one you chose during PostgreSQL installation.
# The default superuser is "postgres".

# ---------- Database ----------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/schememedia

# Optional. Defaults to DATABASE_URL with a "_test" suffix, which is almost
# always what you want. Uncomment only to point tests elsewhere.
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/schememedia_test

# Set to true ONLY when using a pooled endpoint (Neon's pooler, or any
# PgBouncer in transaction mode). Leave false for a local installation.
DB_DISABLE_STATEMENT_CACHE=false

# ---------- Application ----------
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# Comma-separated. Never use "*" -- invalid alongside credentials.
CORS_ORIGINS=http://localhost:3000

# ---------- AI assistant (services/assistant.py) ----------
# gemini (default) has a genuine free tier -- get a key at
# https://aistudio.google.com/apikey. anthropic is optional and paid.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------- Assistant usage/cost guardrails (core/assistant_guard.py) ----------
# Kill switch: set to false + redeploy to stop every assistant call
# instantly, no code change, if usage or cost looks wrong.
ASSISTANT_ENABLED=true
# Process-wide daily cap, independent of the per-IP per-minute rate limit
# (core/rate_limit.py). Configurable because the provider's own free-tier
# quota (observed ~20/day for gemini-3.6-flash) is not this app's to define
# and will change with the provider, plan, or model.
ASSISTANT_DAILY_LIMIT=20
# How long an identical (exact, whitespace-trimmed) assistant question is
# served from cache instead of spending a real provider call. 0 disables
# caching.
ASSISTANT_CACHE_TTL_SECONDS=120

# ---------- Auth (core/security.py) ----------
# REQUIRED in production (APP_ENV=production) -- the app refuses to start
# with the default value there. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Safe to leave as the default for local/test -- it can never sign a
# production token (see core/config.py's _reject_default_secret_in_production).
JWT_SECRET_KEY=insecure-dev-secret-change-me-before-deploying
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Optional Docker Compose only ----------
# Ignored during native local development.
POSTGRES_USER=schememedia
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=schememedia
POSTGRES_PORT=5432
API_PORT=8000
