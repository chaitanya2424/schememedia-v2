# Staging environment template. Copy to .env.staging.example.local (or
# whatever the hosting platform's secret-injection mechanism expects) and
# fill in real values there -- never commit filled-in values.
#
# Staging exists to catch config/deploy problems before production ever
# sees them, so it MUST use infrastructure production never touches:
# a separate database and a separate Gemini API key. Sharing either with
# production defeats the entire point of having a staging environment.

# ---------- Database ----------
# A SEPARATE PostgreSQL instance/database from production. Never point
# staging at the production database "just to save a database" -- a
# staging migration or a bad test write must never be able to touch
# production data.
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/schememedia_staging

# Set to true only if this staging database is behind a pooler (e.g.
# Neon's pooled endpoint). See README section "Connecting to Neon".
DB_DISABLE_STATEMENT_CACHE=false

# ---------- Application ----------
# "staging" is a real value of Settings.app_env (core/config.py) --
# already distinct from "production", so /docs and /openapi.json can stay
# enabled here for internal debugging while still being disabled in prod.
APP_ENV=staging
LOG_LEVEL=INFO
LOG_JSON=true

# The deployed staging frontend's real origin. Never "*".
CORS_ORIGINS=https://staging.schememedia.example.com

# ---------- AI assistant ----------
# A SEPARATE Gemini API key from production, ideally from a separate
# Google Cloud project (see the production-Gemini-readiness notes) --
# staging traffic must never consume production's quota or spend, and a
# leaked staging key must never expose the production key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------- Frontend build (Flutter) ----------
# Passed at build time, not read from this file directly -- see
# apps/frontend/lib/core/config/env.dart. Example:
#   flutter build web --dart-define=API_BASE_URL=https://staging-api.schememedia.example.com/api/v1
#   flutter build apk --dart-define=API_BASE_URL=https://staging-api.schememedia.example.com/api/v1
# API_BASE_URL=https://staging-api.schememedia.example.com/api/v1
